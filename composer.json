{
    "name": "jonasarts/registry2-bundle",
    "description": "A Registry System for Symfony",
    "keywords": ["registry", "key", "value", "store"],
    "homepage": "https://github.com/jonasarts/registry2-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Jonas Hauser",
            "email": "symfony@jonasarts.com",
            "homepage": "https://www.jonasarts.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/config": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "If you want to use the DoctrineRegistry (default engine).",
        "snc/redis-bundle": "One way to provide a redis client service for the Redis engine.",
        "predis/predis": "A redis client usable as redis.client_service for the Redis engine.",
        "symfony/form": "Required for the built-in CRUD controllers (ui.enabled).",
        "symfony/twig-bundle": "Required for the built-in CRUD controllers (ui.enabled).",
        "symfony/security-csrf": "Required for CSRF protection of the built-in CRUD controllers (ui.enabled)."
    },
    "autoload": {
        "psr-4": { "jonasarts\\Bundle\\RegistryBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "jonasarts\\Bundle\\RegistryBundle\\Tests\\": "tests/" }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "symfony/yaml": "^7.0|^8.0",
        "doctrine/orm": "^3.0",
        "doctrine/dbal": "^4.0",
        "rector/rector": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "rector": "rector process",
        "rector-check": "rector process --dry-run",
        "test": "phpunit --testsuite unit"
    }
}
