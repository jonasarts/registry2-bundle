{% extends base_template %}

{% block title %}
System Key List
{% endblock %}

{% block body %}
<h1>System Key List</h1>
{% for flashMessage in app.flashes('error') %}
    <div class="alert alert-danger">
        {{ flashMessage }}
    </div>
{% endfor %}
<p><a href="{{ path('registry_index') }}">View Registry Key List</a></p>
<p class="pull-right"><a href="{{ path('system_new') }}" class="btn btn-success">Add</a></p>
<p><table class="table table-striped">
    <thead>
        <tr>
            <th>Key</th>
            <th>Name</th>
            <th>Type</th>
            <th>Value</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for entity in entities %}
        <tr>
            <td>{{ entity.key }}</td>
            <td>{{ entity.name }}</td>
            <td>{{ entity.type.value }}</td>
            <td>{{ entity.value }}</td>
            <td>
                <a href="{{ path('system_edit', { key: entity.key, name: entity.name, type: entity.type.value }) }}" class="btn">Edit</a>
                <form method="post" action="{{ path('system_delete') }}" style="display:inline" onsubmit="return confirm('Delete this key?');">
                    <input type="hidden" name="key" value="{{ entity.key }}">
                    <input type="hidden" name="name" value="{{ entity.name }}">
                    <input type="hidden" name="type" value="{{ entity.type.value }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('system_delete') }}">
                    <button type="submit" class="btn">Delete</button>
                </form>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table></p>
{% endblock %}
